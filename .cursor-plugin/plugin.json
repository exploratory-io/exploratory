{
  "name": "exploratory",
  "displayName": "Exploratory",
  "version": "0.1.0",
  "description": "Work with Exploratory Desktop, search and read published notes, dashboards, charts, analytics and data, and query data on the server. Desktop works on macOS and Windows. Server signs in with OAuth and is read-only.",
  "author": {
    "name": "Exploratory, Inc.",
    "email": "support@exploratory.io"
  },
  "homepage": "https://github.com/exploratory-io/exploratory",
  "repository": "https://github.com/exploratory-io/exploratory",
  "keywords": [
    "exploratory",
    "data",
    "analytics",
    "dashboards",
    "mcp"
  ],
  "category": "integrations",
  "mcpServers": {
    "exploratory-server": {
      "type": "http",
      "url": "https://exploratory.io/mcp"
    },
    "exploratory-desktop": {
      "type": "stdio",
      "command": "node",
      "args": ["${CURSOR_PLUGIN_ROOT}/scripts/exploratory-desktop-mcp.js"]
    }
  },
  "skills": [
    "./skills/",
    "./skills/mcp-server/",
    "./skills/mcp-desktop/"
  ],
  "license": "MIT",
  "logo": "./assets/icon.png"
}
