#!/bin/sh
set -eu
bundle=${EXPLORATORY_MCP_BUNDLE:-}
if [ ! -f "$bundle" ]; then
  bundle=/Applications/Exploratory.app/Contents/Resources/app.nw/mcp/exploratory-mcp.bundle.js
fi
if [ ! -f "$bundle" ]; then
  echo 'Exploratory Desktop MCP bundle was not found. Install Exploratory or set EXPLORATORY_MCP_BUNDLE.' >&2
  exit 1
fi
exec node "$bundle" "$@"
